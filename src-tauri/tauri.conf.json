{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editor CAA",
  "version": "0.1.0",
  "identifier": "it.sraffa.caa-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      { "title": "Editor CAA", "width": 1100, "height": 800 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' picto: http://picto.localhost https://picto.localhost data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
